local MobileGui = nil

local function DestroyMobileGui()
	if MobileGui then MobileGui:Destroy(); MobileGui = nil end
	for k in pairs(MobileKeys) do MobileKeys[k] = false end
end

local function CreateMobileGui()
	DestroyMobileGui()

	MobileGui = Instance.new("ScreenGui")
	MobileGui.Name = "FlightMobileGui"
	MobileGui.ResetOnSpawn = false
	MobileGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	MobileGui.Parent = PlayerGui

	local function MakeButton(label, pos, size, color, onDown, onUp)
		local btn = Instance.new("TextButton")
		btn.Size = size or UDim2.new(0, 70, 0, 70)
		btn.Position = pos
		btn.AnchorPoint = Vector2.new(0.5, 0.5)
		btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 40)
		btn.BackgroundTransparency = 0.3
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = label
		btn.TextScaled = true
		btn.Font = Enum.Font.GothamBold
		btn.AutoButtonColor = false
		btn.BorderSizePixel = 0
		btn.Parent = MobileGui

		Instance.new("UICorner", btn).CornerRadius = UDim.new(0.2, 0)

		local stroke = Instance.new("UIStroke", btn)
		stroke.Color = Color3.fromRGB(255, 255, 255)
		stroke.Transparency = 0.7
		stroke.Thickness = 1.5

		btn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1 then
				btn.BackgroundColor3 = Color3.fromRGB(80, 80, 200)
				onDown()
			end
		end)
		btn.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1 then
				btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 40)
				onUp()
			end
		end)
		btn.MouseLeave:Connect(function()
			btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 40)
			onUp()
		end)
		return btn
	end

	local S = UDim2.new
	local btnSize = S(0, 72, 0, 72)
	local padX, padY, step = 0.12, 0.82, 0.085

	MakeButton("▲", S(padX,0,padY-step,0), btnSize, Color3.fromRGB(35,35,35),
		function() MobileKeys.Forward=true end, function() MobileKeys.Forward=false end)
	MakeButton("▼", S(padX,0,padY+step,0), btnSize, Color3.fromRGB(35,35,35),
		function() MobileKeys.Back=true end, function() MobileKeys.Back=false end)
	MakeButton("◀", S(padX-step,0,padY,0), btnSize, Color3.fromRGB(35,35,35),
		function() MobileKeys.Left=true end, function() MobileKeys.Left=false end)
	MakeButton("▶", S(padX+step,0,padY,0), btnSize, Color3.fromRGB(35,35,35),
		function() MobileKeys.Right=true end, function() MobileKeys.Right=false end)

	local vertX = 0.88
	MakeButton("⬆ UP", S(vertX,0,padY-step*0.6,0), S(0,80,0,72), Color3.fromRGB(30,100,30),
		function() MobileKeys.Up=true end, function() MobileKeys.Up=false end)
	MakeButton("⬇ DN", S(vertX,0,padY+step*0.6,0), S(0,80,0,72), Color3.fromRGB(120,30,30),
		function() MobileKeys.Down=true end, function() MobileKeys.Down=false end)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0,160,0,28)
	lbl.Position = UDim2.new(padX,-80,padY-step*2.1,0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.fromRGB(200,200,200)
	lbl.TextScaled = true
	lbl.Font = Enum.Font.Gotham
	lbl.Text = "✈ FLIGHT CONTROLS"
	lbl.Parent = MobileGui
end

